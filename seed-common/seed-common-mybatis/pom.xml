<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.yak33</groupId>
    <artifactId>seed-common</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>seed-common-mybatis</artifactId>
  <description>MyBatis-Plus 公共件：BaseEntity、BaseMapperPlus、分页 PageQuery/TableDataInfo、字段自动填充</description>

  <dependencies>
    <dependency>
      <groupId>io.github.yak33</groupId>
      <artifactId>seed-common-satoken</artifactId>
    </dependency>
    <!-- provided 语义：由最终应用（seed-server）引入 starter，这里只保证编译 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- 3.5.9+ 分页插件依赖 jsqlparser 单独成包 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- PageQuery 上的分页参数校验注解 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

</project>
